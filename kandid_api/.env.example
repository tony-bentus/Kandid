# Application
NODE_ENV=development
PORT=3000

# HTTP
CORS_ORIGIN=*

# Database (local Docker Compose)
# Leave DATABASE_URL empty to use the individual DB_* variables.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=kandid
DB_PASSWORD=kandid
DB_DATABASE=kandid
DB_SSL=false
DB_LOGGING=false

# Auth (required, minimum 16 characters)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
